^SAMPLE = GSM9060720
!Sample_title = Mouse brain endothelial cells, ipsilateral hemisphere, vehicle treated sham
!Sample_geo_accession = GSM9060720
!Sample_status = Public on Jul 01 2025
!Sample_submission_date = Jun 23 2025
!Sample_last_update_date = Jul 01 2025
!Sample_type = SRA
!Sample_channel_count = 1
!Sample_source_name_ch1 = brain endothelium
!Sample_organism_ch1 = Mus musculus
!Sample_taxid_ch1 = 10090
!Sample_characteristics_ch1 = tissue: brain endothelium
!Sample_characteristics_ch1 = cell type: endothelial cells
!Sample_characteristics_ch1 = genotype: wild-type
!Sample_characteristics_ch1 = treatment: vehicle
!Sample_characteristics_ch1 = age: 8-12 weeks
!Sample_characteristics_ch1 = Sex: male
!Sample_characteristics_ch1 = strain: C57BL/6J
!Sample_characteristics_ch1 = batch: 8/23/2022
!Sample_treatment_protocol_ch1 = Injection of PF-429242 or vehicle
!Sample_molecule_ch1 = total RNA
!Sample_extract_protocol_ch1 = For FACS sorting, cell suspensions were obtained upon digesting brain tissue in 2 mg/ml Dispase II (D4693, Sigma-Aldrich), 2 mg/mL Collagenase IV (#1710401, Thermo Fisher Scientific, Zurich, Switzerland) and 2 mM CaCl2 PBS (40 min at 37°C). The suspension was filtered through 100/70/40 μm cell strainers (#431751, Corning, New York, USA) and cells were then centrifuged 300 g for 7 min, and resuspended in 9 ml PBS, followed by another round of centrifugation. Cell pellets were resuspended in 3 mL of ACK hemolytic buffer. To stop the reaction, 30 mL of ice-cold PBS was added and centrifuged at 300 g for 7 min. Pellets were resuspended in PBS + 1% BSA. For FACS sorting, cells were stained with anti-CD31 and anti-CD45 (see Table 3). Following washes with PBS + 1% BSA the suspension was passed through a 35 μm cell strainer of a FACS sorting tube (#352235, Corning). Cells were sorted by a FACS Aria III (648282D2, BD Bioscience) sorter using the four-way purity sorting mode.  Live events were acquired and analyzed using Flowjo 10.0.6 software (Tree Star Inc.).  FACS-sorted endothelial cells were resuspended at a 1,000 cells/μL.
!Sample_extract_protocol_ch1 = scRNA-seq libraries were obtained following the 10x Genomics recommended protocol using the reagents included in the Chromium Single Cell v3.3 Reagent Kit. Libraries were sequenced on a NextSeq 500 (Illumina, Inc., San Diego, CA, USA) at the Princess Marget Genomics Center (University Health Network, Toronto, ON, Canada), aiming at 50k reads per cell.
!Sample_description = Library name: Sample 1
!Sample_description = 10x Genomics
!Sample_data_processing = The 10x Genomics scRNA-seq data was processed using Cell Ranger v6.1.2 with the Mouse reference, mm10 (GENCODE vM23/ Ensembl 98).
!Sample_data_processing = Assembly: Mouse mm10
!Sample_data_processing = Supplementary files format and content: Tab-separated values files and matrix files
