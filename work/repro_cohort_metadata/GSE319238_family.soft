^SERIES = GSE319238
!Series_title = Single-cell transcriptomic analysis of microglia and brain cells after ischemic stroke
!Series_geo_accession = GSE319238
!Series_status = Public on Mar 11 2026
!Series_submission_date = Feb 11 2026
!Series_last_update_date = Aug 27 2026
!Series_pubmed_id = 42129556
!Series_summary = To investigate microglial heterogeneity and the effects of Zfp384 perturbation on brain cell populations after ischemic stroke, we performed single-cell RNA-seq of microglia and total brain cells from mouse brains at multiple conditions after middle cerebral artery occlusion (MCAO).
!Series_overall_design = Single-cell RNA-seq of FACS-sorted microglia from sham-operated, post-ischemic day 14 (Igf1-CreER;Ai14), day 28 (Zfp384flox/flox vs. Cx3cr1-CreER;Zfp384flox/flox; ASO-control vs. ASO-Zfp384), and day 56 (ASO-control vs. ASO-Zfp384) mouse brains; and total brain cells from sham-operated, post-ischemic day 14, and day 28 (ASO-control vs. ASO-Zfp384) mouse brains.
!Series_type = Expression profiling by high throughput sequencing
!Series_contributor = Jun,,Tsuyama
!Series_contributor = Seiichiro,,Sakai
!Series_contributor = Yuichiro,,Hara
!Series_contributor = Hideya,,Kawaji
!Series_contributor = Takashi,,Shichita
