^SAMPLE = GSM8262819
!Sample_title = Female microglia, Sham, Day 3
!Sample_geo_accession = GSM8262819
!Sample_status = Public on Jul 01 2024
!Sample_submission_date = May 11 2024
!Sample_last_update_date = Jul 02 2026
!Sample_type = SRA
!Sample_channel_count = 1
!Sample_source_name_ch1 = brain
!Sample_organism_ch1 = Mus musculus
!Sample_taxid_ch1 = 10090
!Sample_characteristics_ch1 = tissue: brain
!Sample_characteristics_ch1 = Sex: Female
!Sample_characteristics_ch1 = cell type: microglial cells
!Sample_characteristics_ch1 = genotype: Tmem119-2A-CreERT2;Ai6
!Sample_characteristics_ch1 = treatment: Sham surgery
!Sample_treatment_protocol_ch1 = pMCAO was performed by permanent ligation of the right middle cerebral artery. Body temperature was monitored during the entire surgical process. Sham mice underwent similar surgical procedure without ligation of the middle cerebral artery.
!Sample_molecule_ch1 = total RNA
!Sample_extract_protocol_ch1 = Mice were intubated, anesthesized with isoflurane and transcardially perfused. Brains were immediately harvested and only the ipsilateral hemisphere was proccessed. Brain tissue was dissociated by mechanical dissociation, filtered (70 um). A percoll gradient  were used to isolate enriched microglial cells yield (pellet) after centrifugation . Samples were resuspended in FASC buffer (RPMI1640, 2% FBS, and 2 mM EDTA). Four samples per condition were combined at this step. Next, live ZsGreen+ cells were sorted using fluorescence-activated cell sorting (BD FACSAria II) and immediately after sequenced (Novaseq 6000).
!Sample_extract_protocol_ch1 = 10x Genomics Chromium Controller Single-Cell Instrument (10x Genomics, Pleasanton, CA, USA) was used to generate single-cell gel beads with reverse transcription (RT) reagents in emulsions (GEMs). After GEM-RT was performed, the single-strand cDNA was purified with DynaBeads MyOne Silane Beads (Thermo Fisher Scientific). The cDNA was then amplified and purified. Indexed sequencing libraries were constructed using the Chromium Single-Cell 3’ v3.1 Library Kit following the manufacture’s instruction. The barcoded sequencing libraries were quantified and loaded on a Novaseq 6000 (Illumina, San Diego, CA, USA) for sequencing.
!Sample_description = 10X Genomics
!Sample_description = F_Sham
!Sample_data_processing = Alignment, counting, filtering, of single cell RNA-Seq of all 4 samples , using 10X Cellranger v7.1.0 with default parameters.
!Sample_data_processing = Assembly: mm10-2020-A custome ref with ZsGreen seq added
!Sample_data_processing = Supplementary files format and content: raw read counts in gene-barcode matrix
!Sample_platform_id = GPL24247
!Sample_contact_name = Wei,,Yang
!Sample_contact_email = yang.lab.duke@gmail.com
!Sample_contact_institute = Duke University
