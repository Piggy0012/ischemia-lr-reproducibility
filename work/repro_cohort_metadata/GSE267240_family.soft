^SERIES = GSE267240
!Series_title = Microglial heterogeneity in the ischemic stroke mouse brain of both sexes
!Series_geo_accession = GSE267240
!Series_status = Public on Jul 01 2024
!Series_submission_date = May 11 2024
!Series_last_update_date = Jul 02 2026
!Series_pubmed_id = 39095897
!Series_summary = The objective of the current study was to dissect the effect of permanent stroke on the diversity of microglia, the resident immune cells within the brain parenchyma.
!Series_overall_design = To characterize microglial diversity after permanent stroke in Tmem119-2A-CreERT2;Ai6 mice in which microglia were labeled with ZsGreen, we sorted ZsGreen positive cells on day 3 after stroke for scRNA-seq analysis. Four samples were analayzed: female_sham, female_stroke, male_sham, and male_stroke,  (F_Sham, F_Stroke, M_Sham, M_Stroke). Each sample were pooled from 4 mice.
!Series_type = Expression profiling by high throughput sequencing
!Series_contributor = Angela,,del Aguila
!Series_contributor = Vaibhav,,Jain
!Series_contributor = Wei,,Yang
!Series_sample_id = GSM8262819
!Series_sample_id = GSM8262820
!Series_sample_id = GSM8262821
!Series_sample_id = GSM8262822
