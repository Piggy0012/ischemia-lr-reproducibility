^SERIES = GSE171393
!Series_title = Differentiation independent neuroprotective role of Vcan+ oligodendrocyte precursor cells in Post-stroke cognitive impairment recovery
!Series_geo_accession = GSE171393
!Series_status = Public on Apr 02 2023
!Series_submission_date = Apr 02 2021
!Series_last_update_date = Jan 09 2024
!Series_pubmed_id = 38180614
!Series_summary = We investigate the single cell transcriptome of hippocampus in both groups. A total of 27,069 cells were identified as 13 cell types, belong to neuronal, glial and vascular lineages. Then the cell-specific molecular changes and function in PSCI were analyzed.
!Series_overall_design = Examination of 2 sham and 2 two-vessel occlusion ischemia mouse model hippocampi samples
!Series_type = Expression profiling by high throughput sequencing
