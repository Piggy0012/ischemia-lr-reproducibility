^PLATFORM = GPL28330
!Platform_title = DNBSEQ-T7 (Mus musculus)
!Platform_geo_accession = GPL28330
!Platform_status = Public on Mar 30 2020
!Platform_submission_date = Mar 30 2020
!Platform_last_update_date = Mar 30 2020
