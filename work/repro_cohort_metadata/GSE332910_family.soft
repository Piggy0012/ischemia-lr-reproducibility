^SERIES = GSE332910
!Series_title = SnRNA-seq, snATAC-seq and Stereo-seq datasets of mouse striatum at different time points in MCAO/R
!Series_geo_accession = GSE332910
!Series_status = Public on Sep 09 2026
!Series_submission_date = May 22 2026
!Series_last_update_date = Sep 10 2026
!Series_pubmed_id = 42693582
!Series_summary = Ischemic stroke constitutes a multifaceted neurological affliction involving diverse cell types in the brain. A lack of dynamic transcriptional and chromatin accessibility data in the post-stroke period remains a key barrier to elucidating the underlying mechanisms. We employed snRNA-seq, snATAC-seq and Stereo-seq to construct a comprehensive transcriptional and chromatin accessibility landscape of the striatum covering the acute (0 h), subacute (24 h), and chronic (7 d, 14 d) phases post-MCAO/R mice.
!Series_overall_design = Multiome-seq: Single nuclei were extracted from unimmunized mice and immunized mice at 0 h, 24 h, 7 d and 14 d post-MCAO/R. Joint snRNA-, scATAC and Stereo-seq libraries were prepared using the BGI Genomics.
!Series_type = Expression profiling by high throughput sequencing
!Series_type = Genome binding/occupancy profiling by high throughput sequencing
!Series_contributor = Ruolin,,Zhang
!Series_contributor = Chang,,Liu
