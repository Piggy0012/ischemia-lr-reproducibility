^DATABASE = GeoMiame
!Database_name = Gene Expression Omnibus (GEO)
!Database_institute = NCBI NLM NIH
!Database_web_link = http://www.ncbi.nlm.nih.gov/geo
!Database_email = geo@ncbi.nlm.nih.gov
^SERIES = GSE279665
!Series_title = Transcriptome analysis of the course of ischemic stroke from acute to chronic phase in mice
!Series_geo_accession = GSE279665
!Series_status = Public on Feb 20 2026
!Series_submission_date = Oct 17 2024
!Series_last_update_date = Feb 21 2026
!Series_pubmed_id = 41223896
!Series_summary = We examined comprehensive gene expression in the mouse brain under physiological conditions at  single cell-transcriptomic levels. In addition, Sytox-negative cells were sorted and analyzed for gene expression. We performed single cell RNA-seq for mouse brain and found that the neurons could no recovered for further analyses. We successfully obtained oligodendrocyte progenitor cells (OPCs), oligodendrocytes, microglia, endothelial cells, and pericytes, but were unable to obtain neurons.  Additionally, we were only able to obtain astrocytes to a limited extent.We were able to examine comprehensive gene expression in the physiological brain.
!Series_overall_design = B6.129S4-Pdgfratm11(EGFP)Sor/J mouse brain were dissociated enzymatically, and then the cell suspensions were isolated by cell sorting (FACS) according to absence of Sytox signal. The sorted cells were analyzed using single cell RNA sequencing.
!Series_type = Expression profiling by high throughput sequencing
!Series_contributor = Takeshi,,Ikegami
!Series_contributor = Tsutomu,,Sasaki
!Series_sample_id = GSM8577691
!Series_sample_id = GSM8577692
