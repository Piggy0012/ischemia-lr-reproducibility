^SAMPLE = GSM8577691
!Sample_title = brain_1
!Sample_geo_accession = GSM8577691
!Sample_status = Public on Feb 20 2026
!Sample_submission_date = Oct 17 2024
!Sample_last_update_date = Feb 20 2026
!Sample_type = SRA
!Sample_channel_count = 1
!Sample_source_name_ch1 = Brain
!Sample_organism_ch1 = Mus musculus
!Sample_taxid_ch1 = 10090
!Sample_characteristics_ch1 = tissue: Brain
!Sample_characteristics_ch1 = strain: B6.129S4-Pdgfratm11(EGFP)Sor/J
!Sample_molecule_ch1 = total RNA
!Sample_extract_protocol_ch1 = Tissue was obtained from mouse brains by shaving with a razor blade. The resulting tissue was washed in PBS and dissociated into single cells using the Adult Brain Dissociation Kit.
!Sample_extract_protocol_ch1 = RNA-seq library was constructed using a modified sciRNA-seq protocol. The target cells were sorted into 384-well plates with barcoded oligo dT primer for each well (1 cell / well). After reverse transcription in each well, cDNA was pre-amplified using the xGen™ ssDNA & Low-Input DNA Prep (IDT). Purified cDNAs were tagmentationed with Amplicon Tagment enzyme (Illumina) and PCR for library construction was done by using NEBNext High-Fidelity 2× PCR Master Mix (NEB).
!Sample_data_processing = Sequencing outputs were demultiplexed using bcl2fastq2 (v2.20.0.422)
!Sample_data_processing = Fastq files were aligned to Mus musculus mm10 reference using STAR aligner (2.7.9a)
!Sample_data_processing = Assembly: Mouse reference, mm10
!Sample_data_processing = Supplementary files format and content: Processed data files are gzipped STAR output directory (Solo.out).
!Sample_platform_id = GPL30172
!Sample_contact_name = Takashi,,Shimbo
!Sample_contact_email = shimbot@sts.med.osaka-u.ac.jp
!Sample_contact_institute = Osaka university
