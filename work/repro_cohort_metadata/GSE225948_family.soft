!Sample_library_strategy = RNA-Seq
!Sample_relation = BioSample: https://www.ncbi.nlm.nih.gov/biosample/SAMN33425164
!Sample_relation = SRA: https://www.ncbi.nlm.nih.gov/sra?term=SRX19486462
!Sample_supplementary_file_1 = ftp://ftp.ncbi.nlm.nih.gov/geo/samples/GSM7060nnn/GSM7060838/suppl/GSM7060838_Blood_GR18121902_counts.csv.gz
