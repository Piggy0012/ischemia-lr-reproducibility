^SAMPLE = GSM9514174
!Sample_title = RNA-seq of mouse microglia, MCAO day 6, Yy1flox/flox control replicate 3
!Sample_geo_accession = GSM9514174
!Sample_status = Public on Mar 11 2026
!Sample_submission_date = Feb 11 2026
!Sample_last_update_date = Mar 11 2026
!Sample_type = SRA
!Sample_channel_count = 1
!Sample_source_name_ch1 = brain
!Sample_organism_ch1 = Mus musculus
!Sample_taxid_ch1 = 10090
!Sample_characteristics_ch1 = tissue: brain
!Sample_characteristics_ch1 = cell type: microglia
!Sample_characteristics_ch1 = genotype: Yy1flox/flox
!Sample_characteristics_ch1 = treatment: MCAO
!Sample_treatment_protocol_ch1 = Transient brain ischemia, induced by middle cerebral artery occlusion (MCAO), was generated in male mice between 8 and 24 weeks of age, with a weight range of 20 to 30 g. Anesthesia was induced by 3% isoflurane with a mixture of 70% nitrous oxide and 30% oxygen, and maintained by 1% isoflurane during the operation. Silicone-coated monofilaments were inserted through the common carotid artery to occlude the origin of the middle cerebral artery. Reperfusion was facilitated by withdrawing the inserted monofilaments 60 minutes after MCAO. Head temperature was maintained at 36°C. Inclusion criteria required confirmation of a >60% reduction in cerebral blood flow using laser Doppler flowmetry. Sham-operated mice underwent the same surgical procedure without occlusion.
!Sample_growth_protocol_ch1 = All mice were maintained in a conventional facility at the Institute of Science Tokyo or Tokyo Metropolitan Institute of Medical Science in Tokyo, Japan. All experiments were approved by the Institutional Animal Research Committee of the Institute of Science Tokyo (approval number: A2025-011C2) and Tokyo Metropolitan Institute of Medical Science (approval number: 21-004). C57BL/6J mice were used for WT mice.
!Sample_molecule_ch1 = total RNA
!Sample_extract_protocol_ch1 = Sham-operated mice or mice after MCAO were transcardially perfused with saline, and then the forebrain was removed. After homogenization with RPMI-1640, 1 mg ml–1 collagenase (Sigma-Aldrich) and 50 mg ml–1 DNase I (Sigma-Aldrich) were added to the homogenates. Brain homogenates were digested for 25 min and subjected to Percoll (GE Healthcare) gradient centrifugation. From the interlayer between 37% and 70% Percoll, cells were isolated and stained with anti-CD45 FITC (30-F11, eBioscience), anti-CD11b PerCP-Cy5.5 (M1/70, eBioscience), and anti-CD31 PE/Cyanine7 (390, eBioscience). The cells were sorted using a FACSAria III cell sorter (BD/Thermo Fisher Scientific).
!Sample_extract_protocol_ch1 = Total RNA was purified using a RNeasy micro kit (Qiagen) and used for the preparation of RNA-seq libraries by an Ovation SoLo RNA-Seq Library Preparation Kit (Tecan), according to the manufacturer's procedure. Following the assessment of quantity and fragment size distribution of cDNA libraries by Agilent TapeStation 4150, the libraries were sequenced by Illumina HiSeq 2500. Libraries for the Day 14 Igf1 cohort were sequenced on Illumina NovaSeq 6000.
!Sample_description = Library name: bulkRNA_Day06_Yy1flox_Rep3
!Sample_description = RNA-seq of FACS-sorted CD45(int)CD11b(int) microglia from Yy1flox/flox mouse brain on day 6 after stroke onset (biological replicate 3). Libraries were sequenced by Illumina HiSeq 2500.
!Sample_description = bulkRNA_Yy1_gene_counts.txt
!Sample_data_processing = Reads were aligned to the mm10 annotation file using STAR, and the read counts for each gene were determined through featureCounts.
!Sample_data_processing = Normalization and differential expression analysis were performed using edgeR. DEGs were identified by edgeR.
!Sample_data_processing = Gene ontology analysis was performed using DAVID (https://david.ncifcrf.gov/).
!Sample_data_processing = Assembly: mm10 (GRCm38)
!Sample_data_processing = Supplementary files format and content: Tab-delimited text file containing gene-level raw counts (rows: genes, columns: samples).
!Sample_platform_id = GPL17021
!Sample_contact_name = Jun,,Tsuyama
!Sample_contact_email = tsuyama.j.662a@m.isct.ac.jp
