^SERIES = GSE319237
!Series_title = Transcriptomic profiling of mouse microglia after ischemic stroke
!Series_geo_accession = GSE319237
!Series_status = Public on Mar 11 2026
!Series_submission_date = Feb 11 2026
!Series_last_update_date = Aug 27 2026
!Series_pubmed_id = 42129556
!Series_summary = To investigate time-dependent changes in gene expression in microglia after ischemic stroke, we performed RNA-seq of FACS-sorted  microglia from mouse brains at multiple time points after middle cerebral artery occlusion (MCAO).
!Series_overall_design = RNA-seq of microglia collected from sham-operated and post-ischemic day 1, 6, 14, and 28 mouse brains (wild-type); Igf1-Egfp transgenic mice on day 6 and day 14 (EGFP+ vs. EGFP– microglia); and Cx3cr1-CreER;Yy1flox/flox vs. Yy1flox/flox mice on day 6 (3 biological replicates each).
!Series_type = Expression profiling by high throughput sequencing
!Series_contributor = Tsuyama,,Jun
!Series_contributor = Shichita,,Takashi
