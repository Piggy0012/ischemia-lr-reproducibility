^SERIES = GSE247102
!Series_title = Deletion of Slc9a1 in Cx3cr1+ cells stimulated microglial subcluster CREB1-BDNF signaling and oligodendrocyte crosstalk
!Series_geo_accession = GSE247102
!Series_status = Public on Nov 06 2023
!Series_submission_date = Nov 06 2023
!Series_last_update_date = Jul 02 2026
!Series_pubmed_id = 38509618
!Series_summary = Microglial Na/H exchanger-1 (NHE1) protein, encoded by Slc9a1, plays a role in white matter demyelination of ischemic stroke brains. In this study, we conducted single cell RNA-seq transcriptome analysis of corpus collosum and external capsule from wild-type (WT) and conditional Slc9a1 knockout (cKO) mice at 3 days post-stroke to study microglia-oligodendrocyte interactions.
!Series_overall_design = White matter tissues were dissected from the WT or Nhe1 cKO brains at 3 days post-tMCAO
!Series_overall_design = 
!Series_overall_design = Grant ID: 933134 (Career Development Award)
!Series_overall_design = Grant title: Modulating microglia-oligodendrocyte interactions for white matter repair
!Series_overall_design = Funding source: American Heart Association
!Series_overall_design = Grantee: Shanshan Song
!Series_type = Expression profiling by high throughput sequencing
!Series_contributor = Shanshan,,Song
!Series_contributor = Chaim,,Sneiderman
!Series_contributor = Gary,,Kohanbash
!Series_contributor = Dandan,,Sun
!Series_sample_id = GSM7883314
!Series_sample_id = GSM7883315
!Series_sample_id = GSM7883316
!Series_sample_id = GSM7883317
