^SAMPLE = GSM6443690
!Sample_title = sham-brain,  scRNAseq
!Sample_geo_accession = GSM6443690
!Sample_status = Public on Jun 14 2023
!Sample_submission_date = Aug 10 2022
!Sample_last_update_date = Jul 02 2026
!Sample_type = SRA
!Sample_channel_count = 1
!Sample_source_name_ch1 = Brain
!Sample_organism_ch1 = Mus musculus
!Sample_taxid_ch1 = 10090
!Sample_characteristics_ch1 = tissue: Brain
!Sample_characteristics_ch1 = treatment: sham surgey
!Sample_treatment_protocol_ch1 = Mice treated middle cerebral artery occlusion (MCAO) means they were anesthetized with 3% isoflurane in 67%:30% N2O/ O2 (induction), until they were unresponsive to the tail pinch test and were then fitted with a nose cone providing 1.5% isoflurane for anesthesia maintenance. A monofilament was introduced into the common carotid artery, advanced to the origin of the middle cerebral artery, and left in position for 60 minutes until reperfusion.Sham-operated animals underwent the same anesthesia and surgical procedures except MCAO.
!Sample_growth_protocol_ch1 = Male C57/BL6 mice were purchased from Shanghai SLAC Laboratory Animals and were housed under standard laboratory conditions (22°C and a 12‐hour light‐dark cycle with free access to food and water).
!Sample_molecule_ch1 = total RNA
!Sample_extract_protocol_ch1 = BD Rhapsody system was used to capture the transcriptomic information of the single cells. Single-cell capture was achieved by random distribution of a single-cell suspension across >200,000 microwells
!Sample_extract_protocol_ch1 = RNA libraries were generated by BD Rhapsody singel cell RNA-seq and prepared for sequencing using standard Illumina protocols
!Sample_description = BD Rhapsody
!Sample_data_processing = Basecalls performed using CASAVA version 1.8
!Sample_data_processing = Umi-tools was utilized to calculate the raw counts and cell whitelist by default parameter
!Sample_data_processing = We applied the Seurat [https://satijalab.org/seurat/] package for cell normalization and cell filtering considering the MT percentage, minimum and maximum gene numbers under following criteria:   MT% < 30%;    Cell Gene Number < Median Gene Number * 2;   Cell Gene Number > 200.  PCA and tSNE analysis was used for the single cell to cell relation description. Graphcluster and K-mean was utilized for cell clustering and based on the marker gene achieved some cluster was combined. Wilcox rank sum test was then used for marker gene analysis.
!Sample_data_processing = Assembly: mm10
!Sample_data_processing = Supplementary files format and content: TXT file contain counts and barcodes for each sample
!Sample_platform_id = GPL24247
!Sample_contact_name = Yueman,,Zhang
!Sample_contact_email = altaszhang@gmail.com
!Sample_contact_phone = 19121710063
!Sample_contact_institute = Department of Anesthesiology,  Renji Hospital, School of Medicine Shanghai Jiao Tong University, China
!Sample_contact_address = 160 Pujian Rd
!Sample_contact_city = Shanghai
!Sample_contact_zip/postal_code = 200127
!Sample_contact_country = China
!Sample_instrument_model = Illumina NovaSeq 6000
!Sample_library_selection = cDNA
!Sample_library_source = transcriptomic
!Sample_library_strategy = RNA-Seq
!Sample_relation = BioSample: https://www.ncbi.nlm.nih.gov/biosample/SAMN30244892
!Sample_relation = SRA: https://www.ncbi.nlm.nih.gov/sra?term=SRX17025828
!Sample_supplementary_file_1 = ftp://ftp.ncbi.nlm.nih.gov/geo/samples/GSM6443nnn/GSM6443690/suppl/GSM6443690_sham.cellname.txt.gz
!Sample_supplementary_file_2 = ftp://ftp.ncbi.nlm.nih.gov/geo/samples/GSM6443nnn/GSM6443690/suppl/GSM6443690_sham.counts.tsv.gz
!Sample_series_id = GSE210986
!Sample_data_row_count = 0
