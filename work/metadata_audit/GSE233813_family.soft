^SAMPLE = GSM7437217
!Sample_title = sham [snRNA-Seq]
!Sample_geo_accession = GSM7437217
!Sample_status = Public on Nov 18 2024
!Sample_submission_date = May 31 2023
!Sample_last_update_date = Nov 18 2024
!Sample_type = SRA
!Sample_channel_count = 1
!Sample_source_name_ch1 = brain
!Sample_organism_ch1 = Mus musculus
!Sample_taxid_ch1 = 10090
!Sample_characteristics_ch1 = tissue: brain
!Sample_characteristics_ch1 = strain: C57Black/6
!Sample_characteristics_ch1 = age: 3 month
!Sample_characteristics_ch1 = Sex: male
!Sample_characteristics_ch1 = condition: sham control
!Sample_treatment_protocol_ch1 = Prior to the induction of MCAO, mice were anaesthetized with 3% isoflurane (Aerrane, Baxter) and amaintained in 2% isoflurane using a vaporizer (Tec-3, Cyprane Ltd.). A skin incision between the orbit and the external auditory meatus was made, and a 1-2 mm hole was drilled through the frontal bone 1 mm rostral to the fusion of the zygoma and the squamosal bone, about 3.5 mm ventrally to the dorsal surface of the brain. The middle cerebral artery (MCA) was exposed after the dura was opened and removed. The MCA was occluded by short coagulation with bipolar tweezers (SMT) at a proximal location, followed by transection of the vessel to ensure permanent occlusion. During the surgery, body temperature was maintained at 37 ± 1C using a heating pad. This MCAO model yields small infarct lesions in the parietal cortical region. Intact cortical tissue from 3 months old mice was used as control.
!Sample_molecule_ch1 = total RNA
!Sample_extract_protocol_ch1 = Injured forebrain hemispheres were frozen on dry ice and stored at -80 °C until processing. For each condition, three hemispheres were collected and pooled during the single-nucleus suspension preparation. All steps for nuclei isolation were performed on ice, with instruments and plastics pre-chilled on ice, or centrifugation steps at 4°C. The frozen brain tissues were combined with 2 ml of lysis buffer (10 mM Tris, pH = 7.4; 10 mM NaCl; 3 mM MgCl2; 0.1 % NP-40; 0.2 U/ul RNaseOUT; 0.32 M Sucrose; 1x protease inhibitor, Roche) and transferred to 2 ml Dounce tissue grinder (Sigma). Tissues were homogenized by 20 strokes with pestle A, followed by 20 strokes with pestle B and filtered using 30 um filter (Celltricks). Tissue grinder was rinsed with 1 ml HEB buffer (Hibernate A, ThermoFisher; 10 ul/ml GlutaMAX, ThermoFisher; 0.32 M Sucrose) and the wash filtered into the same tube. Homogenates were split by careful pipetting of 1.2 ml into two 2 ml tubes prefilled with 500 ul sucrose cushion (1.2 M sucrose; 10 mM Tris; 10 mM NaCl; 3 mM MgCl2; 0.2 U/ul RNase OUT) and centrifuged at 13000 g for 20 minutes at 4°C. Supernatants were removed, except 100 ul to keep the pellets covered. Pellets with the remaining supernatant were resuspended in 1 ml sucrose solution (1.0 M sucrose; 10 mM Tris; 10 mM NaCl; 3 mM MgCl2; 0.2 U/ul RNase OUT), pipetted into 2 ml tubes prefilled with 500 ul sucrose cushion and again centrifuged at 13000 g for 20 minutes at 4°C. Supernatants were removed and the pellets resuspended in 1 ml of Nuclei Wash Buffer (DPBS without calcium and magnesium; 0.5 % BSA; 0.2 U/ul RNase OUT; all ThermoFisher) and transferred into 1.5 ml tubes. Samples were centrifuged at 500 g for 5 minutes, the pellets resuspended in 1 ml of Nuclei Wash Buffer and centrifuged again. The final pellets with nuclei were resuspended in 1 ml of Nuclei Wash Buffer and filtered using 30 um filter. Nuclei stained with Propidium Iodide were counted using CellDrop Automated Cell Counter (Denovix) at default settings. Nuclei suspensions were diluted to final concentrations of 1000 nuclei/ul and single-nucleus RNA-Seq (snRNA-Seq) libraries were prepared.
!Sample_extract_protocol_ch1 = Single-nucleus RNA-Seq (snRNA-Seq) libraries were prepared using Chromium Next GEM Single Cell 3' Kit v3.1 (1000268, 10X Genomics) according to the manufacturer’s protocol.
!Sample_description = 10x Genomics
!Sample_data_processing = Libraries were controlled for contamination using fastq_screen v0.11.1. Reads were mapped against the mouse genome GRCm38 and counted using annotation genecode.vM8 using STAR v2.7.3a with parameters “--soloType CB_UMI_Simple --soloFeatures GeneFull –soloCBmatchWLtype 1MM_multi_pseudocounts –soloUMIdedup 1MM_Directional –soloUMIfiltering MultiGeneUMI”. Empty droplets were filtered out using emptyDrops command from DropletUtils package (v 1.14.1) with lower parameter set to 1000. Background RNA was removed using SoupX package (v 1.5.2) set at the default parameters.
!Sample_data_processing = Assembly: mm10/GRCm38
!Sample_data_processing = Supplementary files format and content: bardcodes.tsv: list of cell barcodes
!Sample_data_processing = Supplementary files format and content: features.tsv: list of gene Ids
!Sample_data_processing = Supplementary files format and content: matrix.mtx: gene expression count data in Matrix Market Exchange Format
!Sample_platform_id = GPL24247
!Sample_contact_name = Lukas,,Valihrach
!Sample_contact_laboratory = Laboratory of Glial Biology and Omics Technologies
!Sample_contact_institute = Institute of Biotechnology, Czech Academy of Science
!Sample_contact_address = Prumyslova 595
!Sample_contact_city = Vestec
!Sample_contact_zip/postal_code = 25250
!Sample_contact_country = Czech Republic
