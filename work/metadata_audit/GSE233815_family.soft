^SAMPLE = GSM7437209
!Sample_title = MCAO_Ctrl_A
!Sample_geo_accession = GSM7437209
!Sample_status = Public on Nov 18 2024
!Sample_submission_date = May 31 2023
!Sample_last_update_date = Nov 18 2024
!Sample_type = SRA
!Sample_channel_count = 1
!Sample_source_name_ch1 = brain
!Sample_organism_ch1 = Mus musculus
!Sample_taxid_ch1 = 10090
!Sample_characteristics_ch1 = tissue: brain
!Sample_characteristics_ch1 = condition: Control
!Sample_characteristics_ch1 = timepoint: Ctrl
!Sample_characteristics_ch1 = replicate: A
!Sample_treatment_protocol_ch1 = Prior to the induction of MCAO, mice were anaesthetized with 3% isoflurane (Aerrane, Baxter) and amaintained in 2% isoflurane using a vaporizer (Tec-3, Cyprane Ltd.). A skin incision between the orbit and the external auditory meatus was made, and a 1-2 mm hole was drilled through the frontal bone 1 mm rostral to the fusion of the zygoma and the squamosal bone, about 3.5 mm ventrally to the dorsal surface of the brain. The middle cerebral artery (MCA) was exposed after the dura was opened and removed. The MCA was occluded by short coagulation with bipolar tweezers (SMT) at a proximal location, followed by transection of the vessel to ensure permanent occlusion. During the surgery, body temperature was maintained at 37 ± 1C using a heating pad. This MCAO model yields small infarct lesions in the parietal cortical region. Intact cortical tissue from 3 months old mice was used as control.
!Sample_molecule_ch1 = polyA RNA
!Sample_extract_protocol_ch1 = Samples were collected from the injured cortical region (including affected as well as non-affected brain tissue) and homogenized using the TissueLyser (QIAGEN). Total RNA was extracted with TRI Reagent (Sigma-Aldrich) according to the manufacturer’s protocol and treated with TURBO DNA-free kit (Thermo Fisher). RNA quantity and purity was assessed using the NanoDrop 2000 spectrophotometer (Thermo Fisher) and RNA integrity was assessed using the Fragment Analyzer (Agilent). All samples had RQN > 8.
!Sample_extract_protocol_ch1 = Libraries were prepared from 400 ng total RNA with QuantSeq 30 Library Prep Kit FWD (Lexogen) according to manufacturer’s protocol. 1 µl of ERCC spike-in (c = 0.01x; Thermo Fisher) per library was included. Libraries were quantified on the Qubit 2 fluorometer (Thermo Fisher) and Fragment Analyzer (Agilent), and sequenced on the NextSeq 500 high-output (Illumina) with 85 bp single-end reads. 11.5 – 38 million reads were obtained per library with a median of 16 million reads
!Sample_description = MCAO_Ctrl_A
!Sample_data_processing = Adaptor sequences and low-quality reads were removed using TrimmomaticSE v0.36. Reads mapping to mtDNA and rRNA were filtered out using SortMeRNA v2.1 with default parameters. The remaining reads were aligned to GRCm38 and ERCC reference using STAR v2.5.2b with default parameters81. Mapped reads were counted over Gencode vM8 gene annotation using htseq-count with union mode for handling of overlapping reads.
!Sample_data_processing = We filtered the data for genes with >10 reads and normalized them by varianceStabilizingTransformation function. We applied the DESeq model using DESeq function with type of fit parameter set to ‘local’.
!Sample_data_processing = Assembly: mm10/GRCm38
!Sample_data_processing = Supplementary files format and content: tab-delimited text file containing DESeq normalized expression matrix.
!Sample_platform_id = GPL19057
!Sample_contact_name = Lukas,,Valihrach
!Sample_contact_laboratory = Laboratory of Glial Biology and Omics Technologies
!Sample_contact_institute = Institute of Biotechnology, Czech Academy of Science
!Sample_contact_address = Prumyslova 595
!Sample_contact_city = Vestec
!Sample_contact_zip/postal_code = 25250
!Sample_contact_country = Czech Republic
!Sample_instrument_model = NextSeq 500
!Sample_library_selection = cDNA
!Sample_library_source = transcriptomic
!Sample_library_strategy = RNA-Seq
!Sample_relation = BioSample: https://www.ncbi.nlm.nih.gov/biosample/SAMN35546724
!Sample_relation = SRA: https://www.ncbi.nlm.nih.gov/sra?term=SRX20554190
