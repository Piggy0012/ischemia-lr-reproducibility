!Sample_relation = SRA: https://www.ncbi.nlm.nih.gov/sra?term=SRX20554183
!Sample_supplementary_file_1 = ftp://ftp.ncbi.nlm.nih.gov/geo/samples/GSM7437nnn/GSM7437202/suppl/GSM7437202_MCAO_7D_C_union_name.count.txt.gz
