!Sample_title = sham [scRNA-Seq]
!Sample_geo_accession = GSM7437213
!Sample_status = Public on Nov 18 2024
!Sample_submission_date = May 31 2023
!Sample_last_update_date = Nov 18 2024
!Sample_type = SRA
!Sample_channel_count = 1
!Sample_source_name_ch1 = brain
!Sample_organism_ch1 = Mus musculus
!Sample_taxid_ch1 = 10090
!Sample_characteristics_ch1 = tissue: brain
!Sample_characteristics_ch1 = strain: C57Black/6
!Sample_characteristics_ch1 = age: 3 month
!Sample_characteristics_ch1 = Sex: male
!Sample_characteristics_ch1 = condition: sham control
!Sample_treatment_protocol_ch1 = Prior to the induction of MCAO, mice were anaesthetized with 3% isoflurane (Aerrane, Baxter) and amaintained in 2% isoflurane using a vaporizer (Tec-3, Cyprane Ltd.). A skin incision between the orbit and the external auditory meatus was made, and a 1-2 mm hole was drilled through the frontal bone 1 mm rostral to the fusion of the zygoma and the squamosal bone, about 3.5 mm ventrally to the dorsal surface of the brain. The middle cerebral artery (MCA) was exposed after the dura was opened and removed. The MCA was occluded by short coagulation with bipolar tweezers (SMT) at a proximal location, followed by transection of the vessel to ensure permanent occlusion. During the surgery, body temperature was maintained at 37 ± 1C using a heating pad. This MCAO model yields small infarct lesions in the parietal cortical region. Intact cortical tissue from 3 months old mice was used as control.
!Sample_molecule_ch1 = total RNA
!Sample_extract_protocol_ch1 = The Plp1/tdTomato mice were deeply anesthetized with pentobarbital (PTB) (100 mg/kg, i.p.), and perfused transcardially with a cold (4–8°C) isolation buffer containing (in mM): NaCl 136.0, KCl 5.4, HEPES 10.0, glucose 5.5, osmolality 290±3 mOsmol/kg. To isolate the control and ischemic areas, the brain was sliced into 600 µm coronal sections using a vibrating microtome Leica VT1200S (Leica Microsystems). The collected tissue was incubated with continuous shaking at 37°C for 45 min in 1 ml of papain solution (20 U/ml) and 0.2 ml DNase (both from Worthington) prepared in isolation buffer. After papain treatment, the tissue was mechanically dissociated by gentle trituration using a 1 ml pipette. The dissociated cells were layered on top of 5 ml of ovomucoid inhibitor solution (Worthington) and harvested by centrifugation (70 x g for 6 min). This method routinely yielded ~2 x 10^6 cells per mouse brain. Cell aggregates were removed by filtering with 70 µm cell strainers (Becton Dickinson). Three animals per condition were pooled in the preparation of cell suspension. After obtaining an aliquot for FACS, the cell suspension was spin down, concentrated, and used for library preparation. Single cell suspension from Plp1/tdTomato mice were sorted using fluorescent activated cell sorting (FACS; BD Influx). The flow cytometer was manually calibrated to deposit a single cell in the center of collection tube. Hoechst 33258 (Life Technologies) was added to the suspension of cells to check viability. 3000 Plp1+ cells from each group (control, D1, D3, D7) were collected into 96-well plates (Life Technologies) coated with BSA (ThermoFisher Scientific) and containing 5 μl of DMEM (ThermoFisher Scientific) and 15% FBS (HyClone).
!Sample_extract_protocol_ch1 = Single-cell RNA-Seq (scRNA-Seq) libraries were prepared using Chromium Next GEM Single Cell 3' Kit v3.1 (1000268, 10X Genomics) according to the manufacturer’s protocol.
!Sample_description = 10x Genomics
!Sample_data_processing = Libraries were controlled for contamination using fastq_screen v0.11.1. Reads were mapped against the mouse genome GRCm38 and counted using annotation genecode.vM8 using STAR v2.7.3a with parameters “--soloType CB_UMI_Simple --soloFeatures Gene –soloCBmatchWLtype 1MM_multi_pseudocounts –soloUMIdedup 1MM_Directional –soloUMIfiltering MultiGeneUMI”. Empty droplets were filtered out using emptyDrops command from DropletUtils package (v 1.14.1) with lower parameter set to 1000.
!Sample_data_processing = Assembly: mm10/GRCm38
!Sample_data_processing = Supplementary files format and content: bardcodes.tsv: list of cell barcodes
!Sample_data_processing = Supplementary files format and content: features.tsv: list of gene Ids
!Sample_data_processing = Supplementary files format and content: matrix.mtx: gene expression count data in Matrix Market Exchange Format
!Sample_platform_id = GPL24247
!Sample_contact_name = Lukas,,Valihrach
!Sample_contact_laboratory = Laboratory of Glial Biology and Omics Technologies
!Sample_contact_institute = Institute of Biotechnology, Czech Academy of Science
!Sample_contact_address = Prumyslova 595
!Sample_contact_city = Vestec
!Sample_contact_zip/postal_code = 25250
!Sample_contact_country = Czech Republic
!Sample_instrument_model = Illumina NovaSeq 6000
!Sample_library_selection = cDNA
!Sample_library_source = transcriptomic single cell
!Sample_library_strategy = RNA-Seq
!Sample_relation = BioSample: https://www.ncbi.nlm.nih.gov/biosample/SAMN35546772
!Sample_relation = SRA: https://www.ncbi.nlm.nih.gov/sra?term=SRX20554853
!Sample_supplementary_file_1 = ftp://ftp.ncbi.nlm.nih.gov/geo/samples/GSM7437nnn/GSM7437213/suppl/GSM7437213_sc-sham_barcodes.tsv.gz
!Sample_supplementary_file_2 = ftp://ftp.ncbi.nlm.nih.gov/geo/samples/GSM7437nnn/GSM7437213/suppl/GSM7437213_sc-sham_genes.tsv.gz
!Sample_supplementary_file_3 = ftp://ftp.ncbi.nlm.nih.gov/geo/samples/GSM7437nnn/GSM7437213/suppl/GSM7437213_sc-sham_matrix.mtx.gz
!Sample_series_id = GSE233812
!Sample_series_id = GSE233815
!Sample_data_row_count = 0
