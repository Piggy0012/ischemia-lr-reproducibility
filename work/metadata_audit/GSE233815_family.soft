!Sample_relation = SRA: https://www.ncbi.nlm.nih.gov/sra?term=SRX20554230
!Sample_supplementary_file_1 = ftp://ftp.ncbi.nlm.nih.gov/geo/samples/GSM7437nnn/GSM7437219/suppl/GSM7437219_sn-D3_barcodes.tsv.gz
!Sample_supplementary_file_2 = ftp://ftp.ncbi.nlm.nih.gov/geo/samples/GSM7437nnn/GSM7437219/suppl/GSM7437219_sn-D3_genes.tsv.gz
!Sample_supplementary_file_3 = ftp://ftp.ncbi.nlm.nih.gov/geo/samples/GSM7437nnn/GSM7437219/suppl/GSM7437219_sn-D3_matrix.mtx.gz
