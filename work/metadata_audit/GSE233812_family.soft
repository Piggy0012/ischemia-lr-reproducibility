^DATABASE = GeoMiame
!Database_name = Gene Expression Omnibus (GEO)
!Database_institute = NCBI NLM NIH
!Database_web_link = http://www.ncbi.nlm.nih.gov/geo
!Database_email = geo@ncbi.nlm.nih.gov
^SERIES = GSE233812
!Series_title = Spatiotemporal transcriptomic map of glial cell response in a mouse model of acute brain ischemia [scRNA-Seq]
!Series_geo_accession = GSE233812
!Series_status = Public on Nov 18 2024
!Series_submission_date = May 31 2023
!Series_last_update_date = Nov 19 2024
!Series_pubmed_id = 39499634
!Series_summary = We performed spatial and single-cell transcriptomics on male mouse brains to map out the molecular and cellular processes governing the response to ischemic stroke during the first week after the injury. Focusing on glial cells, we documented their activation, the formation of the glial scar, and significant changes in cell–cell communication patterns. Interestingly, we identified various activated populations of oligodendrocytes that, while similar in their anti-inflammatory properties, differ in their immunogenic and metabolic characteristics. This challenges the long-held belief that oligodendrocytes play a passive role in neuropathologies. Altogether, we present a major contribution to the current understanding of the role of glial cells in stroke pathobiology, comprehensively mapping their acute response and role in the formation of the glial scar.
!Series_overall_design = To invesigate ischemic brain injury, mouse model of permanent middle cerebral artery occlusion was used. Screened timepoints include control, day 1, 3, and 7 post the injury. For each timepoint, three forebrain hemispheres (bregma from ~ +3 to -4 mm) were collected, pooled, FACS-sorted and processed with scRNA-Seq protocol.
!Series_type = Expression profiling by high throughput sequencing
!Series_contributor = Daniel,,Zucha
!Series_contributor = Pavel,,Abaffy
!Series_contributor = Denisa,,Kirdajova
!Series_contributor = Lukas,,Valihrach
!Series_contributor = Daniel,,Jirak
!Series_contributor = Mikael,,Kubista
!Series_contributor = Miroslava,,Anderova
!Series_sample_id = GSM7437213
!Series_sample_id = GSM7437214
!Series_sample_id = GSM7437215
!Series_sample_id = GSM7437216
