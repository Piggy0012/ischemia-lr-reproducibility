^SERIES = GSE174574
!Series_title = Single-cell RNA-seq reveals the transcriptional landscape in ischemic stroke
!Series_geo_accession = GSE174574
!Series_status = Public on Sep 24 2021
!Series_submission_date = May 17 2021
!Series_last_update_date = Jul 02 2026
!Series_pubmed_id = 34496660
!Series_pubmed_id = 39217343
!Series_summary = Here, we employed single-cell RNA sequencing (scRNA-seq) to comprehensively map the cell populations in the mouse model of MCAO (middle cerebral artery occlusion).
!Series_overall_design = Single cell suspension was prepared from mouse brain tissues at 24 h after MCAO or sham-operations.
!Series_type = Expression profiling by high throughput sequencing
!Series_contributor = Kai,,Zheng
!Series_contributor = Junwei,,Hao
!Series_sample_id = GSM5319987
!Series_sample_id = GSM5319988
